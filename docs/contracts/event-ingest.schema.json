{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracemind.local/schemas/event-ingest.schema.json",
  "title": "IngestEvent",
  "description": "Raw event as submitted to POST /api/v1/telemetry/events (M1). Untrusted input.",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "service", "environment", "timestamp", "severity", "message"],
  "properties": {
    "event_id": { "type": "string", "minLength": 1, "maxLength": 128, "description": "Optional client-supplied id; used for duplicate detection. Generated by the server when absent." },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "service": { "type": "string", "minLength": 1, "maxLength": 128 },
    "environment": { "type": "string", "minLength": 1, "maxLength": 64 },
    "timestamp": { "type": "string", "format": "date-time", "description": "RFC 3339. Offsets are converted to UTC; a missing offset is rejected." },
    "severity": { "type": "string", "minLength": 1, "maxLength": 16, "description": "Case-insensitive; aliases such as WARN/FATAL are mapped to the normalized enum." },
    "message": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "error_type": { "type": ["string", "null"], "maxLength": 256 },
    "stack_trace": { "type": ["string", "null"], "maxLength": 32768 },
    "trace_id": { "type": ["string", "null"], "maxLength": 64 },
    "span_id": { "type": ["string", "null"], "maxLength": 32 },
    "release": { "type": ["string", "null"], "maxLength": 128 },
    "commit_sha": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{7,40}$" },
    "attributes": { "type": "object", "maxProperties": 64, "additionalProperties": true }
  }
}

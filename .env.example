# Copy to .env and fill in. Never commit .env.

# --- Local PostgreSQL (infra/docker-compose.yml) ---
POSTGRES_PASSWORD=
TRACEMIND_DATABASE_URL=postgresql+psycopg://tracemind:<password>@127.0.0.1:55432/tracemind
TRACEMIND_TEST_DATABASE_URL=postgresql+psycopg://tracemind:<password>@127.0.0.1:55432/tracemind_test

# --- Temporary per-project ingest keys (M1; replaced by real auth in M5) ---
# config/projects.json names the env var that holds each project's key. Use 24+ random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TRACEMIND_PROJECTS_FILE=config/projects.json
TRACEMIND_KEY_PROJECT_DEMO=

# --- Repository intelligence (M2) ---
# Local repositories may only be registered under these directories (os.pathsep-separated).
TRACEMIND_REPO_ROOTS=
# TraceMind-owned snapshots and graphs. Never inside a repository root.
TRACEMIND_DATA_DIR=data
# The pinned Graphify CLI, installed by: python -m tools.install_graphify
TRACEMIND_GRAPHIFY_BIN=
# TRACEMIND_SCAN_TIMEOUT_SECONDS=300
# TRACEMIND_SCAN_MAX_ATTEMPTS=3
# TRACEMIND_SCAN_LEASE_SECONDS=900
# TRACEMIND_SCAN_BACKOFF_SECONDS=5

# --- Shipper / demo app ---
TRACEMIND_INGEST_URL=http://127.0.0.1:8000
TRACEMIND_INGEST_KEY=            # same value as the key of the project being shipped to
DEMO_PROJECT_ID=project-demo
DEMO_SERVICE=demo-payments
DEMO_ENVIRONMENT=development
DEMO_PAYMENT_GATEWAY_URL=        # deliberately required by the config-error scenario; leave empty to reproduce it
# DEMO_RELEASE=
# DEMO_COMMIT_SHA=               # only set if it is the real commit; never invented

# --- Snowflake (M3; NOT in use yet: nothing reads these variables until M3 is authorized) ---
# Provide these only through your secure configuration process (this git-ignored .env file, or an OS or
# cloud secret store). Never paste values into chat and never commit them. Private keys stay in files
# OUTSIDE the repository with restricted permissions; only their PATHS and passphrases are configured.
# Two service users with two separate encrypted key pairs: the exporter (writer) and the query service
# (reader). Migrator, test-cleanup and administrator credentials NEVER appear here: those roles are held
# by a human in an interactive Snowsight session and have no key pair.
# Secret: *_PRIVATE_KEY_PASSPHRASE (and the key files the paths point to). Not secret, but private:
# SNOWFLAKE_ACCOUNT (orgname-account_name). Everything else is a name or a number.
# The exporter is OFF unless this is true; see docs/setup/snowflake-account-setup.md before enabling it.
TRACEMIND_SNOWFLAKE_ENABLED=false
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE_JWT
SNOWFLAKE_WAREHOUSE=TRACEMIND_WH
SNOWFLAKE_DATABASE=TRACEMIND_DEV
SNOWFLAKE_TEST_DATABASE=TRACEMIND_TEST
# Writer / exporter (export worker only)
SNOWFLAKE_WRITER_USER=TRACEMIND_EXPORTER_SVC
SNOWFLAKE_WRITER_ROLE=TRACEMIND_WRITER
SNOWFLAKE_WRITER_PRIVATE_KEY_FILE=
SNOWFLAKE_WRITER_PRIVATE_KEY_PASSPHRASE=
# Reader (API / approved query functions only)
SNOWFLAKE_READER_USER=TRACEMIND_QUERY_SVC
SNOWFLAKE_READER_ROLE=TRACEMIND_READER
SNOWFLAKE_READER_PRIVATE_KEY_FILE=
SNOWFLAKE_READER_PRIVATE_KEY_PASSPHRASE=
# Limits (non-secret). The values shown are PROPOSED defaults, to be settled in M3 slice S2.
# Minimum time between exports. The code must also enforce a floor of 7200 and refuse smaller values at start-up.
# TRACEMIND_SNOWFLAKE_EXPORT_MIN_INTERVAL_SECONDS=14400
# TRACEMIND_SNOWFLAKE_EXPORT_BATCH_MAX_ROWS=1000
# TRACEMIND_SNOWFLAKE_EXPORT_MIN_SEVERITY=ERROR
# TRACEMIND_SNOWFLAKE_QUERY_TIMEOUT_SECONDS=30
# TRACEMIND_SNOWFLAKE_LOCK_TIMEOUT_SECONDS=60
# TRACEMIND_SNOWFLAKE_MAX_ROWS=500
# TRACEMIND_SNOWFLAKE_MAX_CONCURRENCY=2
# TRACEMIND_SNOWFLAKE_SOFT_BUDGET_CREDITS=15

# --- Later milestones (placeholders only) ---
# GROQ_API_KEY=                  # M4
